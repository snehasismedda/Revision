# Frontend Environment Variables
# Leave empty for local development (uses Vite dev server proxy to /api)
# For production (e.g. Vercel deployment), set this to your deployed backend URL:
# Example: VITE_API_URL=https://your-backend-api.vercel.app
# Example: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=
